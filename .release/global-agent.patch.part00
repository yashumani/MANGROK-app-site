 const serviceWorker = await readFile(path.join(root, "sw.js"), "utf8");
-for (const phrase of ["appVersion", "alchemyFunctionName", "src/readiness.js", "src/entitlements.js", "src/mobile-shell.js"]) {
+for (const phrase of [
+  "appVersion", "alchemyFunctionName", "src/readiness.js", "src/entitlements.js", "src/mobile-shell.js",
+  "src/ingredient-catalog-data.js", "src/ingredient-catalog.js", "src/ingredient-community.js",
+  "src/agent-memory.js", "src/agent-runtime.js", "src/agent-memory-ui.js"
+]) {
   if (!runtime.includes(phrase) && !serviceWorker.includes(phrase)) throw new Error(`Missing production-readiness contract: ${phrase}`);
 }
-if (!/mangrok-v7-mobile-app-shell/.test(serviceWorker)) throw new Error("PWA cache was not advanced for the mobile app-shell release.");
+if (!/mangrok-v8-global-ingredient-agent/.test(serviceWorker)) throw new Error("PWA cache was not advanced for the global ingredient and agent-memory release.");
+
+const catalogData = await readFile(path.join(root, "src/ingredient-catalog-data.js"), "utf8");
+const catalogStats = JSON.parse(await readFile(path.join(root, "docs/ingredient-catalog-stats.json"), "utf8"));
+if (!/2026\.08\.13-global-granular-v2/.test(catalogData)) throw new Error("Global granular catalog version is missing.");
+if (Number(catalogStats.count) < 4250) throw new Error(`Ingredient catalog is unexpectedly small: ${catalogStats.count}`);
+if (Number(catalogStats.aliases) < 5000) throw new Error(`Ingredient alias coverage is unexpectedly small: ${catalogStats.aliases}`);
+if (Number(catalogStats.cuisines) < 75) throw new Error(`Cuisine coverage is unexpectedly small: ${catalogStats.cuisines}`);
+
+const agentMemory = await readFile(path.join(root, "src/agent-memory.js"), "utf8");
+for (const phrase of ["MEMORY_ENABLED_KEY", "confirmed", "session-summary", "MEMORY_LIMITS"]) {
+  if (!agentMemory.includes(phrase)) throw new Error(`Missing bounded-memory contract: ${phrase}`);
+}
+
+const migration004 = await readFile(path.join(root, "supabase/migrations/004_global_ingredient_agent_memory.sql"), "utf8");
+for (const phrase of [
+  "ingredient_catalog_versions", "ingredient_submissions", "agent_memories", "agent_tool_runs",
+  "service role required", "grant execute on function public.moderate_ingredient_submission"
+]) {
+  if (!migration004.includes(phrase)) throw new Error(`Missing global ingredient or agent-memory database contract: ${phrase}`);
+}
+if (/grant execute on function public\.moderate_ingredient_submission[^;]+authenticated/i.test(migration004)) {
+  throw new Error("Ingredient moderation must not be executable by authenticated browser users.");
+}
 
 const alchemyFunction = await readFile(path.join(root, "supabase/functions/alchemy-ai/index.ts"), "utf8");
 for (const phrase of ["p_request_id", "refund_alchemy_credit", "model_gateway_timeout", "origin_not_allowed"]) {
   if (!alchemyFunction.includes(phrase)) throw new Error(`Missing Alchemy gateway safety contract: ${phrase}`);
 }
 
-console.log("Mangrok Alchemy static validation passed.");
+console.log(`Mangrok global ingredient and agent-memory static validation passed (${catalogStats.count} ingredients, ${catalogStats.aliases} aliases).`);
 

),matches=technique.equipment.filter(v=>names.some(n=>n.includes(v.toLowerCase())||v.toLowerCase().includes(n)));return{score:equipment.length?(matches.length?96:58):45,matches,ideal:technique.equipment,message:matches.length?`${matches[0]} suits this method.`:`Consider ${technique.equipment.slice(0,2).join(" or ")} for this technique.`}}

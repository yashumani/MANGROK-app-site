Insight(base,ai){if(!ai||typeof ai!=="object")return base;const adj=clamp(Math.round(Number(ai.confidenceAdjustment)||0),-10,10);return Object.freeze({...base,title:clean(ai.title,140)||base.title,summary:clean(ai.summary,900)||base.summary,confidence:clamp(base.confidence+adj,1,99),aiInsights:cleanArray(ai.insights,8,220),risks:mergeRisks(base.risks,ai.risks),suggestions:unique([...base.suggestions,...cleanArray(ai.suggestions,8,240)]).slice(0,10),stages:Array.isArray(ai.stages)&&ai.stages.length?ai.stages.slice(0,8).map(x=>({name:clean(x.name,80),minutes:clamp(Math.round(Number(x.minutes)||1),1,360),cue:clean(x.cue,260)})).filter(x=>x.name&&x.cue):base.stages,evolutions:Array.isArray(ai.evolutions)&&ai.evolutions.length?ai.evolutions.slice(0,6).map(x=>({name:clean(x.name,60),change:clean(x.change,280),reason:clean(x.reason,240)})).filter(x=>x.name&&x.change):base.evolutions,aiEnhanced:true})}
 
 function scoreEquipment(equipment,technique){const names=equipment.map(v=>v.toLowerCase()
+  async listPublishedIngredients({ limit = 500, offset = 0 } = {}) {
+    if (!this.client) return [];
+    const safeLimit = Math.min(1000, Math.max(1, Number(limit) || 500));
+    const safeOffset = Math.max(0, Number(offset) || 0);
+    const { data, error } = await this.client
+      .from("ingredient_catalog")
+      .select("*,ingredient_aliases(alias,language_code,region),ingredient_cuisine_links(cuisine,relationship,confidence)")
+      .eq("status", "published")
+      .order("canonical_name")
+      .range(safeOffset, safeOffset + safeLimit - 1);
+    if (error) throw error;
+    return data || [];
+  }
+
+  async listPersonalIngredients() {
+    if (!this.client || !this.user) return [];
+    const { data, error } = await this.client.from("personal_ingredients").select("*").eq("owner_id", this.user.id).order("updated_at", { ascending: false });
+    if (error) throw error;
+    return data || [];
+  }
+
+  async savePersonalIngredient(ingredient) {
+    if (!this.client || !this.user) return null;
+    const name = String(ingredient?.name || ingredient?.canonicalName || "").trim().slice(0, 100);
+    if (!name) throw new Error("Ingredient name is required.");
+    const row = {
+      owner_id: this.user.id,
+      canonical_name: name,
+      normalized_name: normalizeLookup(name),
+      metadata: safeJsonObject({
+        aliases: ingredient.aliases || [], category: ingredient.category || "Personal ingredients", cuisines: ingredient.cuisines || [],
+        regions: ingredient.regions || [], parts: ingredient.parts || [], processes: ingredient.processes || [], forms: ingredient.forms || [],
+        allergens: ingredient.allergens || [], dietary: ingredient.dietary || [], notes: ingredient.notes || ""
+      }),
+      status: "personal"
+    };
+    const { data, error } = await this.client.from("personal_ingredients").upsert(row, { onConflict: "owner_id,normalized_name" }).select().single();
+    if (error) throw error;
+    return data;
+  }
+
+  async submitIngredientProposal(proposal) {
+    if (!this.client || !this.user) throw new Error("Sign in before submitting an ingredient to the shared catalog.");
+    const name = String(proposal?.canonicalName || proposal?.name || "").trim().slice(0, 100);
+    if (!name) throw new Error("Ingredient name is required.");
+    const personal = await this.savePersonalIngredient({ ...proposal, name });
+    const row = {
+      owner_id: this.user.id,
+      personal_ingredient_id: personal?.id || null,
+      canonical_name: name,
+      normalized_name: normalizeLookup(name),
+      metadata: safeJsonOb